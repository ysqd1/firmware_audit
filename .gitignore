# ---- 机密:绝不上传 ----
.env
.env.*
!.env.example

# ---- 解包/分析产物(体积巨大,不入仓) ----
target/
**/process/extracted/
**/process/filtered/
**/process/analysis/
**/process/agent/
**/process/.cve_cache/
**/process/fileinfo.json

# ---- CVE 共享缓存(firmware_audit/.cve_cache,各 target junction 指向) ----
firmware_audit/.cve_cache/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.coverage
coverage.xml
htmlcov/

# ---- 端到端验证日志(留磁盘取证,不入仓) ----
e2e_*.log

# ---- Docker 构建临时物 / 第三方嵌入源码 / 大型发布包 ----
*.tar.gz
*.tgz
firmware_audit/docker/binwalk/binwalk/
firmware_audit/docker/ghidra/ghidra*.zip.scratch/

.scratch/
firmware_audit/docker/ghidra/ghidra_11.3.2_PUBLIC.zip

# ---- 本地会话/工具状态 ----
.zcode/

# ---- QEMU 执行镜像的 .deb 下载缓存(41MB 二进制,不入仓,radare2 tar.gz 同款) ----
firmware_audit/docker/qemu-exec/deb-cache/
firmware_audit/docker/qemu-exec-v2/src-cache/
