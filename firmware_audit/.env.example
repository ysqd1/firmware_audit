# Step5 审计 LLM 配置(复制为同目录 .env 并填入真实值)
# 规范位置:firmware_audit/.env —— LLMClient 构造时自动加载,环境变量优先于文件。
# OpenAI 兼容接口三字段参数化,不绑定厂商。
FIRMWARE_AUDIT_LLM_BASE_URL=https://api.deepseek.com
FIRMWARE_AUDIT_LLM_API_KEY=sk-你的密钥
FIRMWARE_AUDIT_LLM_MODEL=deepseek-v4-flash

# ---- Step5 Agent 轮次/复核预算(可选;缺失或非法值回落内置默认,下限 1)----
# 各 Agent ReAct 循环轮次上限:recon 侦察 / analysis 深度分析 / verification 单疑点复核 / orchestrator 编排
STEP5_RECON_MAX_ITERS=20
STEP5_ANALYSIS_MAX_ITERS=30
STEP5_VERIFICATION_MAX_ITERS=8
STEP5_ORCHESTRATOR_MAX_ITERS=12
# verification 复核 analysis findings 的前 K 条(按 severity+confidence 排序)
STEP5_VERIFY_K=10

# ---- 其他可选配置(均有内置默认,按需取消注释)----
# 单次补全 max_tokens(推理模型思考+正文分占预算;默认 32768)
#LLM_MAX_TOKENS=32768
# CVE 缓存库目录(默认 target/<N>/process/.cve_cache;可指到共享目录复用预热成果)
#FIRMWARE_AUDIT_CVE_CACHE_DIR=
# 终端监控显示:0 关闭 / compact 紧凑 / full 完整(详见 step5_agent/DISPLAY.md)
#STEP5_DISPLAY=compact
# 终端着色:0/1(默认终端自动开色、管道自动无色)
#STEP5_COLOR=1
# 按工具名排除 Agent 工具(逗号分隔;如误报偏多的 cve_bin_tool_scan)
#STEP5_EXCLUDE_TOOLS=
# 降级工件(.md 无 .json 配对)续跑语义:1=复跑(默认)/0=跳过
#STEP5_RESUME_DEGRADED=0
