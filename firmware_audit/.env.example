# Step5 审计 LLM 配置(复制为同目录 .env 并填入真实值)
# 规范位置:firmware_audit/.env —— LLMClient 构造时自动加载,环境变量优先于文件。
# OpenAI 兼容接口三字段参数化,不绑定厂商。
FIRMWARE_AUDIT_LLM_BASE_URL=https://api.deepseek.com
FIRMWARE_AUDIT_LLM_API_KEY=sk-你的密钥
FIRMWARE_AUDIT_LLM_MODEL=deepseek-v4-flash

# ---- Step5 Host 生命周期预算(ADR-0012;缺失或非法值回落内置默认)----
# 各角色轮次上限:recon 侦察 / analysis 每 Candidate 调查 / verification 每案卷复核
STEP5_RECON_MAX_ITERS=30
STEP5_ANALYSIS_MAX_ITERS=30
STEP5_VERIFICATION_MAX_ITERS=15
# 运行级总预算:LLM 请求数 / 工具执行数 / 活动秒数 / Candidate 处理名额
#STEP5_MAX_LLM_CALLS=400
#STEP5_MAX_TOOL_ATTEMPTS=320
#STEP5_MAX_ACTIVE_SECONDS=7200
#STEP5_CANDIDATE_SLOTS=8

# ---- 其他可选配置(均有内置默认,按需取消注释)----
# 单次补全 max_tokens(推理模型思考+正文分占预算;默认 32768)
#LLM_MAX_TOKENS=32768
# CVE 缓存库目录(cve_bin_tool_scan 专用;Blind Discovery 三角色默认禁用该
# 工具,Host 启动也不做 CVE 缓存预检)
FIRMWARE_AUDIT_CVE_CACHE_DIR=firmware_audit/.cve_cache
# 终端监控显示:0 关闭 / compact 紧凑 / full 完整(详见 step5_agent/DISPLAY.md)
#STEP5_DISPLAY=compact
# 终端着色:0/1(默认终端自动开色、管道自动无色)
#STEP5_COLOR=1
# 按工具名排除 Agent 工具(逗号分隔;如误报偏多的工具)
#STEP5_EXCLUDE_TOOLS=
