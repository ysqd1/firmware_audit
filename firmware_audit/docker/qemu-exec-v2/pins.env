# 固定钉值(票 16:PRoot 5.4.0 + QEMU 11.1.1 执行镜像)——build_image.sh 与
# Dockerfile 共用的单一来源,漂移由 test_qemu_exec_v2_image.py 守护。
# 权威来源与校验证据:.scratch/qemu-user-mode-experiments/investigation/
# proot540-qemu1111-2026-09-22/(80-download-sources.txt:sha256 + 尺寸 + GPG;
# 90-mmpatch-verify.txt:边界拒绝矩阵)。
# 版本为 2026-09-22 用户指定交付目标,不用漂移 latest 选择版本。

# --- QEMU 11.1.1(官方 tarball,静态构建 arm+mips linux-user) ---
QEMU_VERSION=11.1.1
QEMU_URL=https://download.qemu.org/qemu-11.1.1.tar.xz
QEMU_SIG_URL=https://download.qemu.org/qemu-11.1.1.tar.xz.sig
QEMU_TARBALL_SHA256=079ffbff8a7111bbc89022107cbabf3bbfd614d5fc9d7cc675991196aca12482
QEMU_TARBALL_SIZE=141888716

# --- PRoot 5.4.0(上游 tag tarball,源码构建;含 mixed_mode 继承本地补丁) ---
# 上游 auto-archive(archive/refs/tags)非字节稳定:2026-09-22 当天两次下载
# sha256 即不一致。钉值副本 proot-5.4.0.tar.gz 直接入库(225KB),每次构建
# 按下行 sha256 校验;来源与校验证据见 investigation/proot540-qemu1111-2026-09-22/。
PROOT_VERSION=5.4.0
PROOT_TARBALL=proot-5.4.0.tar.gz
PROOT_TARBALL_SHA256=29248aac2a7ce10c3bd5ee5602742ec33b2532310ff9cf73b79f3c133e5a5f68
PROOT_PATCH=proot-mixed-mode-inherit.patch
PROOT_PATCH_SHA256=d55abd0d8c0adb86d8a264368664fb4fbf0ea8273a27681119295bd126f41cdd
# 补丁内容:new_child 继承 mixed_mode(上游遗漏,见补丁头注释);拒绝语义
# 依据 investigation/proot540-qemu1111-2026-09-22/logs/90-mmpatch-verify.txt。

# --- 构建参数 ---
QEMU_BUILD_PARAMS="--static --target-list=arm-linux-user,mips-linux-user --disable-system --disable-tools --disable-docs"
# qemu 构建期要求 meson>=1.5(bookworm 自带 1.0.1 不满足),构建器内 pip 安装。

# --- 基础镜像(按 digest 钉定,不用漂移 tag) ---
# builder(含编译器,仅构建期)与运行基都自 debian 官方库按 digest 拉。
BASE_IMAGE_DIGEST=sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
BUILDER_IMAGE_DIGEST=sha256:f37a335e82bca302e955fa39f9dfe28f1be618f016f8a2b56318e5a5111afc26

# --- 目标镜像(钉 tag,不发布 :latest——latest 漂移禁令见票 01/03) ---
QEMU_EXEC_V2_IMAGE=firm_audit/qemu-exec:p540q1111

# --- 后端必需可执行白名单(镜像剥离后唯一保留;形状隔离,票 16) ---
KEEP_BINARIES="timeout sleep proot qemu-arm-static qemu-mips-static llscan"
