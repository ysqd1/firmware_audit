--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -125,6 +125,13 @@
 		status = translate_execve_enter(tracee);
 		break;
 
+	case PR_execveat:
+		/* QEMU user-mode exposes guest raw execveat as host x86_64
+		 * execveat. Deny it before host path resolution can escape
+		 * the guest boundary; this build does not rewrite it. */
+		status = tracee->qemu != NULL ? -EACCES : 0;
+		break;
+
 	case PR_ptrace:
 		status = translate_ptrace_enter(tracee);
 		break;
