# 固定包钉值(票 03:QEMU 执行镜像)——build_image.sh 与 Dockerfile 共用的单一来源。
# 权威来源:Debian bullseye/main binary-amd64 Packages 索引(apt 安装同源校验),
# 2026-09-21 实测:aliyun 与 deb.debian.org 双源均 200 可下载,
# 本地下载件 sha256 与索引值一致(证据见票 03 Comments)。
# 版本选择依据:bullseye-security 池的 deb11u5 已 404(票 01 调查),
# bullseye(main) 实际可装最新 = 1:5.2+dfsg-11+deb11u3。
QEMU_USER_STATIC_VERSION=1:5.2+dfsg-11+deb11u3
QEMU_USER_STATIC_DEB=qemu-user-static_5.2+dfsg-11+deb11u3_amd64.deb
QEMU_USER_STATIC_DEB_SHA256=0b75df79ae2ddfbc4daab0223a0fc2e79c9be7b1e35c6d030879d4bd21684bca
QEMU_USER_STATIC_DEB_SIZE=41405928
DEB_POOL_URL_ALIYUN=http://mirrors.aliyun.com/debian/pool/main/q/qemu/qemu-user-static_5.2%2bdfsg-11%2bdeb11u3_amd64.deb
DEB_POOL_URL_DEBIAN=http://deb.debian.org/debian/pool/main/q/qemu/qemu-user-static_5.2%2bdfsg-11%2bdeb11u3_amd64.deb
BASE_IMAGE=firm_audit/sandbox:latest
QEMU_EXEC_IMAGE=firm_audit/qemu-exec
